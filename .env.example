# Database — Vercel Postgres (Neon)
# URL con -pooler: per l'app (connessioni normali via PgBouncer)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.neon.tech/dbname?sslmode=require"
# URL senza -pooler: per migrazioni e schema push
DIRECT_URL="postgresql://user:password@ep-xxx.region.neon.tech/dbname?sslmode=require"

# Auth.js v5
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth (dominio aziendale)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Filtro domini email (comma-separated, vuoto = tutti ammessi)
ALLOWED_EMAIL_DOMAINS="simaggioli.it"

# Jira REST API v3 (sola lettura)
JIRA_BASE_URL="https://your-domain.atlassian.net"
JIRA_EMAIL="jira-service-account@domain.com"
JIRA_API_TOKEN="your-jira-api-token"
JIRA_PROJECT_KEY="YOUR_PROJECT_KEY"

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY="phc_your-posthog-key"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
