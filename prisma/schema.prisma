generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum ContractType {
  SUBAPPALTO
  APPALTO
}

enum InitiativeType {
  MEV
  MAD
}

enum InitiativeStatus {
  IN_ATTESA_DI_ALLOCAZIONE
  ALLOCATO
  IN_LAVORAZIONE
  COMPLETATO
  READY_PENDING_RESOURCES
  IN_ATTESA_COPERTURA_CONTRATTUALE
  FUORI_SCOPE
}

enum Priority {
  ALTA
  MEDIA
  BASSA
}

enum SizingSize {
  XS
  S
  M
  L
  XL
}

enum Polarity {
  PRIMA_META
  SECONDA_META
}

enum AnalysisTestSize {
  A_XS
  A_S
  A_M
  A_L
}

enum ReliabilityLevel {
  ALTA
  MEDIA
  BASSA
}

enum EconomicValue {
  UNDER_5K
  FROM_5K_TO_10K
  FROM_10K_TO_15K
  FROM_15K_TO_20K
  FROM_20K_TO_30K
  FROM_30K_TO_40K
  OVER_40K
}

enum ResourceRole {
  FE
  BE
  ANALISTA
  TECH_LEAD
  ARCHITETTO
  PM
  BA_SENIOR
  ALTRO
}

enum ResourceLevel {
  JUNIOR
  MID
  SENIOR
}

enum ResourceType {
  INTERNA
  ESTERNA
}

enum ResourceBelonging {
  BU_DOCUMENTALE
  ENGINEERING_EXCELLENCE
}

enum LockType {
  SOFT
  HARD
}

enum AbsenceType {
  FERIE
  MALATTIA
  PERMESSO
  ALTRO
}

enum AbsenceSource {
  FACTORIAL
  JIRA
}

enum UserRole {
  DEMAND_RESOURCE_MANAGER
  BU_MANAGER
}

enum AlertType {
  SOVRA_ALLOCAZIONE
  SOTTO_UTILIZZO
  SCADENZA_SOFT_LOCK
  READY_PENDING_RESOURCES
  INIZIATIVA_SENZA_ALLOCAZIONI
  PROSSIMITA_SCADENZA_CONTRATTO
  SLITTAMENTO_COEFFICIENTE
  COSTO_SUPERIORE_VALORE
  PROFILO_SATURO
  PIPELINE_VALUE_ELEVATA
  ACCUMULO_PENDING_RESOURCES
}

enum AlertSeverity {
  OPERATIVO
  STRATEGICO
}

enum AlertStatus {
  ATTIVO
  PRESO_IN_CARICO
  SILENZIATO
  RISOLTO
}

enum ImportType {
  RISORSE
  ASSENZE
  INIZIATIVE_JIRA
  CONSUNTIVO
}

// ──────────────────────────────────────────────
// Models
// ──────────────────────────────────────────────

model Application {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules     Module[]
  initiatives Initiative[]

  contracts   Contract[] @relation("ApplicationContracts")
  assignedPMs Resource[] @relation("ApplicationPMs")

  @@map("applications")
}

model Module {
  id            String   @id @default(uuid())
  applicationId String
  name          String
  description   String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application  @relation(fields: [applicationId], references: [id])
  initiatives Initiative[]

  @@map("modules")
}

model Client {
  slug      String   @id
  name      String
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts Contract[]

  @@map("clients")
}

model Contract {
  id                  String       @id @default(uuid())
  identifier          String
  type                ContractType
  clientSlug          String
  amount              Decimal      @db.Decimal(12, 2)
  startDate           DateTime     @db.Date
  endDate             DateTime     @db.Date
  pmEffortPercentage  Decimal      @db.Decimal(5, 2)
  notes               String?      @db.Text
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  client       Client        @relation(fields: [clientSlug], references: [slug])
  applications Application[] @relation("ApplicationContracts")
  initiatives  Initiative[]

  @@map("contracts")
}

model Initiative {
  id                    String            @id @default(uuid())
  code                  String            @unique
  applicationId         String
  moduleId              String?
  contractId            String
  title                 String
  description           String?           @db.Text
  type                  InitiativeType
  priority              Priority
  desiredStartDate      DateTime?         @db.Date
  desiredEndDate        DateTime?         @db.Date
  plannedStartDate      DateTime?         @db.Date
  plannedEndDate        DateTime?         @db.Date
  estimatedDays         Decimal?          @db.Decimal(8, 2)
  requiredProfiles      String?           @db.Text
  status                InitiativeStatus  @default(IN_ATTESA_DI_ALLOCAZIONE)
  sizingSize            SizingSize?
  polarity              Polarity?
  analysisTestSize      AnalysisTestSize?
  affidabilitaStima     ReliabilityLevel?
  vincoliCriticita      String?           @db.Text
  reuseFlag             Boolean           @default(false)
  economicValue         EconomicValue?
  notes                 String?           @db.Text
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  application Application  @relation(fields: [applicationId], references: [id])
  module      Module?      @relation(fields: [moduleId], references: [id])
  contract    Contract     @relation(fields: [contractId], references: [id])
  allocations Allocation[]
  consuntivi  Consuntivo[]

  @@map("initiatives")
}

model Resource {
  id            String            @id @default(uuid())
  firstName     String
  lastName      String
  employeeId    String?
  type          ResourceType
  belonging     ResourceBelonging
  isPTF         Boolean           @default(false)
  attivo        Boolean           @default(true)
  joinDate      DateTime?         @db.Date
  notes         String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  parameters    ResourceParameter[]
  allocations   Allocation[]
  absences      Absence[]
  consuntivi    Consuntivo[]

  managedApps   Application[] @relation("ApplicationPMs")

  @@map("resources")
}

model ResourceParameter {
  id                    String        @id @default(uuid())
  resourceId            String
  role                  ResourceRole
  level                 ResourceLevel
  weeklyHours           Decimal       @db.Decimal(5, 2)
  dailyCost             Decimal       @db.Decimal(10, 2)
  productivityCoeff     Decimal       @db.Decimal(4, 2) @default(1.00)
  weeklyHoursBuffer     Decimal?      @db.Decimal(5, 2)
  validFrom             DateTime      @db.Date
  validTo               DateTime?     @db.Date
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id])

  @@map("resource_parameters")
}

model Allocation {
  id                      String       @id @default(uuid())
  initiativeId            String
  resourceId              String
  lockType                LockType
  softLockExpiry          DateTime?    @db.Date
  allocationPercentage    Int
  startDate               DateTime     @db.Date
  endDate                 DateTime     @db.Date
  allocatedEffortDays     Decimal      @db.Decimal(8, 2)
  roleInInitiative        ResourceRole
  affiancamento           Boolean      @default(false)
  isSeniorAffiancamento   Boolean      @default(false)
  notes                   String?      @db.Text
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  initiative Initiative @relation(fields: [initiativeId], references: [id])
  resource   Resource   @relation(fields: [resourceId], references: [id])

  @@map("allocations")
}

model Absence {
  id         String        @id @default(uuid())
  resourceId String
  date       DateTime      @db.Date
  hours      Decimal       @db.Decimal(4, 1)
  type       AbsenceType
  source     AbsenceSource @default(FACTORIAL)
  notes      String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id])

  @@index([resourceId, date])
  @@map("absences")
}

model Consuntivo {
  id              String   @id @default(uuid())
  initiativeId    String
  resourceId      String
  period          String
  hoursLogged     Decimal  @db.Decimal(8, 2)
  loadDate        DateTime @db.Date
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  initiative Initiative @relation(fields: [initiativeId], references: [id])
  resource   Resource   @relation(fields: [resourceId], references: [id])

  @@unique([resourceId, initiativeId, period])
  @@map("consuntivi")
}

model Alert {
  id                String        @id @default(uuid())
  type              AlertType
  severity          AlertSeverity
  status            AlertStatus   @default(ATTIVO)
  entityType        String
  entityId          String
  message           String        @db.Text
  silenceReason     String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  resolvedAt        DateTime?

  @@map("alerts")
}

model ImportLog {
  id            String     @id @default(uuid())
  type          ImportType
  filename      String
  totalRows     Int
  importedRows  Int
  updatedRows   Int        @default(0)
  errorRows     Int        @default(0)
  errors        Json?
  importedBy    String?
  createdAt     DateTime   @default(now())

  @@map("import_logs")
}

model BUConfiguration {
  id                    String   @id @default(uuid())
  annualBudget          Decimal? @db.Decimal(14, 2)
  weeklyHoursBuffer     Decimal  @db.Decimal(5, 2) @default(8.00)
  saturationMin         Int      @default(75)
  saturationMax         Int      @default(85)
  saturationAlarm       Int      @default(90)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("bu_configuration")
}

model WeeklySnapshot {
  id                       String   @id @default(uuid())
  snapshotDate             DateTime @db.Date
  averageBUSaturation      Decimal  @db.Decimal(5, 2)
  resourcesByBand          Json
  softLockPipelineValue    Decimal  @db.Decimal(14, 2)
  pendingResourcesCount    Int
  createdAt                DateTime @default(now())

  @@unique([snapshotDate])
  @@map("weekly_snapshots")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(BU_MANAGER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}
